{
  "name": "lesca-click",
  "private": false,
  "description": "use for prevent browser default behavior. for web app without scroll.",
  "version": "5.0.1",
  "type": "module",
  "keywords": [
    "lesca",
    "click"
  ],
  "files": [
    "lib"
  ],
  "main": "./lib/index.cjs",
