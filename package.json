    "globals": "^17.13.0",
    "path": "^0.12.7",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vite-plugin-dts": "^5.1.2"
